[Unit]
Description=Personal Site Guestbook API
After=network.target

[Service]
Type=simple
User=personal-site
Group=personal-site
EnvironmentFile=/etc/personal-site-message-api.env
ExecStart=/usr/bin/python3 /opt/personal-site-api/message_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-site-messages

[Install]
WantedBy=multi-user.target
