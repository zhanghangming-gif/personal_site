# Bind and persistent runtime paths
MESSAGE_HOST=127.0.0.1
MESSAGE_PORT=8787
MESSAGE_DB_PATH=/var/lib/personal-site-messages/messages.db
SITE_CONTENT_PATH=/var/lib/personal-site-messages/site-content.json
SITE_UPLOAD_DIR=/var/lib/personal-site-messages/uploads
SCORE_WORK_DIR=/var/lib/personal-site-messages/score-transpose
PROFILE_CONTEXT_PATH=/opt/personal-site-api/profile_context.json

# Generate unique values for production. Never commit real values.
MESSAGE_IP_HASH_SALT=replace-with-random-value
ADMIN_PASSWORD_HASH=

# Optional DeepSeek chat and visual review
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
SCORE_VISION_MODEL=deepseek-vl2

# Optional email verification
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=ssl

# Score processing binaries and limits
SCORE_AUDIVERIS_CMD=/opt/score-tools/audiveris/bin/Audiveris
SCORE_MUSESCORE_CMD=/usr/bin/mscore
SCORE_SKILL_PYTHON=/opt/score-tools/score-venv/bin/python
SCORE_PROCESS_TIMEOUT=1200
SCORE_MAX_BYTES=26214400
SCORE_PREVIEW_DPI=150
SCORE_ANALYSIS_DPI=400
REST_ANNOTATION_DIR=/var/lib/personal-site-messages/rest-annotations/review-v1
REST_ANNOTATION_EXPORTER=/opt/personal-site-api/ml/rest_detector/export_review_queue.py
REST_ANNOTATION_PYTHON=/opt/score-tools/score-venv/bin/python
SCORE_EVALUATION_MANIFEST=/opt/personal-site-api/benchmarks/score-blind/manifest.json
REST_MODEL_PYTHON=/opt/score-tools/rest-model-venv/bin/python
REST_MODEL_WORKER=/opt/personal-site-api/rest_model_worker.py
REST_MODEL_CHECKPOINT=/opt/score-tools/rest-detector/rest-detector-pilot-v2.pt

# Optional score review stages
SCORE_ENGINE=omr
SCORE_AUTO_REPAIR_RESTS=1
SCORE_SYSTEM_COMPOSITOR=0
SCORE_OUTPUT_OMR_AUDIT=0
SCORE_OUTPUT_OMR_AUDIT_MAX_PAGES=8
SCORE_AI_VISUAL_REVIEW=0
SCORE_AI_REVIEW_REGIONS=6
SCORE_AGENT_MODEL=deepseek-chat
SCORE_AGENT_MAX_CALLS=16
